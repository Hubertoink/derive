WEB_PORT=3001
POSTGRES_DB=reado
POSTGRES_USER=reado
POSTGRES_PASSWORD=change-me-for-local-use
DATABASE_URL=postgresql+psycopg://reado:change-me-for-local-use@postgres:5432/reado
READO_PUBLIC_URL=http://localhost:3001
READO_SECRET_KEY=replace-with-a-long-random-secret
CURATOR_API_URL=http://api:8000
# Leave empty: the web container proxies /api/v1 internally.
NEXT_PUBLIC_API_URL=
# Optional: enables an attributed Pexels hero image after each AI search.
PEXELS_API_KEY=

# Creates the first administrator once. After that, use /konto to create
# invitation links; bootstrap variables are never used for subsequent logins.
DERIVE_BOOTSTRAP_ADMIN_USERNAME=
DERIVE_BOOTSTRAP_ADMIN_EMAIL=
DERIVE_BOOTSTRAP_ADMIN_PASSWORD=
DERIVE_ALLOW_PUBLIC_SIGNUP=false
DERIVE_SESSION_TTL_DAYS=14
DERIVE_INVITE_LIFETIME_HOURS=48
# Set true only when the website is served through HTTPS.
DERIVE_AUTH_SECURE_COOKIE=false
